<?php

declare(strict_types=1);

namespace App\Notifications\Messages;

use Illuminate\Bus\Queueable;
use Illuminate\Contracts\Queue\ShouldQueue;
use Illuminate\Database\Eloquent\Relations\Relation;
use Illuminate\Notifications\Notification;
use RoundlyConsulting\Messages\Models\Message;

/**
 * Your copy of the new-message notification, published by
 * `vendor:publish --tag=messages-notifications`. It starts out behaving exactly like the
 * package's own NewMessageNotification; it is yours to edit. Point the package at it in
 * config/messages.php:
 *
 *     'notifications' => [
 *         'notification' => App\Notifications\Messages\NewMessageNotification::class,
 *     ],
 */
class NewMessageNotification extends Notification implements ShouldQueue
{
    use Queueable;

    public function __construct(
        public readonly Message $message,
    ) {}

    /**
     * @return array<int, string>
     */
    public function via(object $notifiable): array
    {
        /** @var array<int, string> $channels */
        $channels = config('messages.notifications.channels', ['database']);

        return $channels;
    }

    /**
     * The database and broadcast payload. `sender_type` is the sender's class basename (`User`),
     * never its class name; `null` for a system message.
     *
     * @return array<string, mixed>
     */
    public function toArray(object $notifiable): array
    {
        $senderType = $this->message->sender_type;

        return [
            'message_id' => $this->message->getKey(),
            'thread_id' => $this->message->thread_id,
            'preview' => $this->message->preview(),
            'sender_id' => $this->message->sender_id,
            'sender_type' => $senderType === null || $senderType === ''
                ? null
                : class_basename(Relation::getMorphedModel($senderType) ?? $senderType),
        ];
    }
}
